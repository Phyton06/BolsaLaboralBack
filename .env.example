# ==========================================
# BolsaLaboralBack - Environment Variables
# ==========================================
# Copia este archivo a .env y ajusta los valores
# cp .env.example .env
#
# ⚠️ NUNCA subas el archivo .env al repositorio

# --- API ---
API_VERSION_URL=api/v1
API_KEY=change_this_to_a_strong_secret_key

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bolsa_laboral
DB_USER=postgres
DB_PASS=

# --- SMTP (Notificaciones y recuperación de contraseña) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Bolsa de Trabajo UTC"

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Logo para emails (opcional) ---
LOGO_URL=
LOGO_ALT=BolsaLaboral Logo
LOGO_WIDTH=60px
LOGO_HEIGHT=60px
